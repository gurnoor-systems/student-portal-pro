# =============================================================================
# STUDENT PORTAL PRO - ENVIRONMENT CONFIGURATION (100% FREE TIER ARCHITECTURE)
# =============================================================================

# 1. Supabase Cloud PostgreSQL (Multi-Device Auth & Metadata Persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 2. Cloudflare R2 Object Storage (10 GB Free Storage, $0 Egress / Bandwidth Bills)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=student-portal-storage

# 3. Email Delivery (Password Reset PINs)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
RESEND_API_KEY=re_optional_backup_key_here

# 4. Master Admin Console Access
NEXT_PUBLIC_ADMIN_EMAILS=gurnoors9507@gmail.com,gurnoor.capital@gmail.com
